<Window x:Class="NewsWall.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NewsWall" Height="600" Width="1000"
        Loaded="MainWindow_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="ControlsRow" />
            <RowDefinition Height="*" x:Name="StreamsRow" />
            <RowDefinition Height="90" x:Name="NewsRow" />
        </Grid.RowDefinitions>

        <!-- Top control bar: dark, thin, streamlined -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- C14 stream enlarge button (left side) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Button x:Name="btnEnlargeLeft" Content="C14"
                            Margin="0,0,0,0" Padding="16,10"
                            Background="#3E3E42" Foreground="White"
                            BorderThickness="0" Click="BtnEnlargeLeft_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3E3E42" />
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#800080" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Market data: Intel, BTC, Strike Radar (centered, stays put when Restore appears) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <!-- Intel prices: only one visible at a time based on market session -->
                    <TextBlock x:Name="txtIntelPricePre" Text="INTC (Pre): $00.00"
                               Foreground="#E8C547" Margin="8"
                               VerticalAlignment="Center" FontSize="15" Visibility="Collapsed" />
                    <TextBlock x:Name="txtIntelPriceRegular" Text="INTC: $00.00"
                               Foreground="#CCCCCC" Margin="8"
                               VerticalAlignment="Center" FontSize="15" Visibility="Collapsed" />
                    <TextBlock x:Name="txtIntelPriceAfter" Text="INTC (After): $00.00"
                               Foreground="#E87E47" Margin="8"
                               VerticalAlignment="Center" FontSize="15" Visibility="Collapsed" />
                    <TextBlock x:Name="txtBtcPrice" Text="BTC: $00,000"
                               Foreground="#CCCCCC" Margin="0,0,24,0"
                               VerticalAlignment="Center" FontSize="15" />
                    <TextBlock x:Name="txtStrikeRadar" Text="Strike: --"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center" FontSize="15" FontWeight="Bold" />
                </StackPanel>

                <!-- i24 and Restore buttons (right side) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnEnlargeRight" Content="i24"
                            Margin="0,0,8,0" Padding="16,10"
                            Background="#3E3E42" Foreground="White"
                            BorderThickness="0" Click="BtnEnlargeRight_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3E3E42" />
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#800080" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btnRestore" Content="↩ Restore Split View"
                            Margin="0,0,0,0" Padding="16,10"
                            Background="#3E3E42" Foreground="White"
                            BorderThickness="0" Visibility="Collapsed"
                            Click="BtnRestore_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3E3E42" />
                                <Setter Property="Foreground" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#800080" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stream grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="ColLeft" />
                <ColumnDefinition Width="*" x:Name="ColRight" />
            </Grid.ColumnDefinitions>

            <!-- C14 stream cell -->
            <Grid Grid.Column="0">
                <wv2:WebView2 x:Name="c14View" Source="https://www.c14.co.il/live" />
            </Grid>

            <!-- i24 Hebrew stream cell -->
            <Grid Grid.Column="1">
                <wv2:WebView2 x:Name="i24View" Source="https://video.i24news.tv/live/brightcove/he" />
            </Grid>
        </Grid>

        <!-- Bottom bar: Rotter news feed (two columns, clickable links) -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="10,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column headlines -->
                    <StackPanel Grid.Column="0" x:Name="spRotterLeft" Margin="0,0,4,0" />

                    <!-- Right column headlines -->
                    <StackPanel Grid.Column="1" x:Name="spRotterRight" Margin="4,0,0,0" />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>